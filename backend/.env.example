TRANSPORT_ERP_APP_NAME=TransportERP-UA
TRANSPORT_ERP_ENVIRONMENT=development
TRANSPORT_ERP_DEPLOYMENT_PROFILE=local
TRANSPORT_ERP_DEBUG=false
# Local profile: DATABASE_URL is optional. If omitted, TransportERP-UA uses
# the platform application-data directory and creates transporterp.db there.
# TRANSPORT_ERP_LOCAL_DATA_DIR=C:/Users/<user>/AppData/Local/TransportERP-UA
# TRANSPORT_ERP_DATABASE_URL=sqlite+pysqlite:///C:/TransportERP-UA/transporterp.db
TRANSPORT_ERP_SESSION_TTL_MINUTES=480
TRANSPORT_ERP_COOKIE_SECURE=false

# Central/server example (explicit opt-in):
# TRANSPORT_ERP_DEPLOYMENT_PROFILE=central
# TRANSPORT_ERP_DATABASE_URL=postgresql+psycopg://transport_erp:change-me@localhost:5432/transport_erp
# TRANSPORT_ERP_COOKIE_SECURE=true
